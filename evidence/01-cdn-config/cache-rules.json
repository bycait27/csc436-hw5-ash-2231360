{
  "rules": [
    {
      "expression": "(http.host eq \"www.csc436.com\")",
      "description": "Cache Frontend HTML",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 7200
        }
      }
    }
  ]
}